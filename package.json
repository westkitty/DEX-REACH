{
  "name": "dex-reach",
  "version": "0.3.2",
  "description": "Secure AI-native remote computing control plane and MCP gateway",
  "scripts": {
    "test": "node --test --import tsx tests/*.test.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gateway": "tsx src/gateway/main.ts",
    "node": "tsx src/node/main.ts",
    "probe:backend": "tsx scripts/probe-backend.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "smoke": "tsx scripts/smoke.ts",
    "install:macos": "npm run build && tsx scripts/install-macos.ts",
    "uninstall:macos": "tsx scripts/uninstall-macos.ts",
    "nodes": "tsx scripts/node-credentials.ts",
    "dex": "tsx scripts/dex-reach.ts",
    "invariants": "tsx scripts/invariants.ts",
    "verify:clean-build": "tsx scripts/verify-clean-build.ts",
    "release:provenance": "tsx scripts/release-provenance.ts",
    "proof": "tsx scripts/proof-run.ts",
    "install:node": "npm run build && tsx scripts/install-node.ts",
    "install:dock": "zsh scripts/install-dock-launcher.sh",
    "verify": "npm run typecheck && npm run invariants -- --check && npm test && npm run build && npm audit --omit=dev --audit-level=high && npm run probe:backend",
    "verify:golden": "npm run verify && npm run smoke"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/server-legacy": "^2.0.0",
    "@wonderwhy-er/desktop-commander": "^0.2.50",
    "express": "^5.1.0",
    "hono": "^4.13.8",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "sharp": "0.35.4",
    "uuid": "11.1.1"
  },
  "bin": {
    "dex-reach": "dist/scripts/dex-reach.js"
  }
}
