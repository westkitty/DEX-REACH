{
  "name": "dex-reach",
  "version": "0.4.0",
  "description": "Secure AI-native remote computing control plane and MCP gateway",
  "scripts": {
    "test": "node --test --test-concurrency=1 --import tsx tests/*.test.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gateway": "tsx src/gateway/main.ts",
    "recovery:c14": "tsx scripts/c14-recovery.ts",
    "control:room": "tsx scripts/control-room.ts",
    "coordinator": "tsx src/coordinator/main.ts",
    "worker": "tsx src/worker/main.ts",
    "node": "tsx src/node/main.ts",
    "probe:backend": "tsx scripts/probe-backend.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "smoke": "tsx scripts/smoke.ts",
    "install:macos": "tsx scripts/install-macos.ts",
    "rollback:macos": "tsx scripts/rollback-macos.ts",
    "uninstall:macos": "tsx scripts/uninstall-macos.ts",
    "nodes": "tsx scripts/node-credentials.ts",
    "dex": "tsx scripts/dex-reach.ts",
    "invariants": "tsx scripts/invariants.ts",
    "conformance:dex": "tsx scripts/dex-contract-conformance.ts",
    "benchmark:c14": "tsx scripts/c14-performance.ts",
    "stress:c14": "tsx scripts/c14-stress.ts",
    "verify:clean-build": "tsx scripts/verify-clean-build.ts",
    "release:provenance": "tsx scripts/release-provenance.ts",
    "release:reproduce": "tsx scripts/reproduce-runtime-release.ts",
    "preproof": "npm run build",
    "proof": "tsx scripts/proof-run.ts",
    "install:node": "npm run build && tsx scripts/install-node.ts",
    "bigmac:stage-node-upgrade": "tsx scripts/stage-bigmac-node-upgrade.ts",
    "bigmac:rollback-node-upgrade": "tsx scripts/rollback-bigmac-node-upgrade.ts",
    "bigmac:activate-node-upgrade": "tsx scripts/activate-bigmac-node-upgrade.ts",
    "install:dock": "zsh scripts/install-dock-launcher.sh",
    "audit:prod": "tsx scripts/audit-gate.ts",
    "verify": "npm run typecheck && npm run invariants -- --check && npm test && npm run audit:prod && npm run probe:backend",
    "verify:golden": "npm run verify && npm run smoke && npm run oauth:canary && npm run oauth:health",
    "oauth:canary": "tsx scripts/oauth-canary.ts",
    "oauth:health": "tsx scripts/oauth-health-check.ts",
    "postbuild": "node scripts/package-native-backend.mjs --destination dist/src/node/compat-runtime",
    "native:package": "node scripts/package-native-backend.mjs",
    "pretest": "npm run build",
    "prenode": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opendocsg/pdf2md": "0.2.9",
    "@vscode/ripgrep": "1.18.0",
    "cross-fetch": "4.1.0",
    "exceljs": "4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.0",
    "fastest-levenshtein": "1.0.16",
    "hono": "^4.13.8",
    "isbinaryfile": "5.0.7",
    "marked": "4.3.0",
    "pdf-lib": "1.17.1",
    "pizzip": "3.2.0",
    "proper-lockfile": "4.1.2",
    "puppeteer-core": "25.16.0",
    "sharp": "0.35.5",
    "unpdf": "1.8.1",
    "ws": "^8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@wonderwhy-er/desktop-commander": "0.2.52"
  },
  "overrides": {
    "sharp": "0.35.5",
    "uuid": "11.1.1",
    "md-to-pdf": {
      "chokidar": "4.0.3"
    }
  },
  "bin": {
    "dex-reach": "dist/scripts/dex-reach.js"
  }
}
